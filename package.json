{
  "name": "mini-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal agent swarm orchestrator for CommonMark renderer A/B coordination experiments",
  "scripts": {
    "spec:extract": "node spec/extract.mjs",
    "spec:generate": "node spec/generate-examples.mjs",
    "score": "node scorer/score.mjs",
    "score:validate": "node scorer/validate-scorer.mjs",
    "preflight:models": "node orchestrator/preflight-models.mjs",
    "run": "node orchestrator/run.mjs",
    "run:coordinated": "node orchestrator/run.mjs --coordination",
    "run:faithful": "node orchestrator/run.mjs --coordination --coord-mode=faithful",
    "run:quick": "node orchestrator/run.mjs --quick",
    "run:quick:coordinated": "node orchestrator/run.mjs --quick --coordination",
    "run:mock": "node orchestrator/run.mjs --mock",
    "run:serial": "node orchestrator/run.mjs --serial",
    "run:v8:bare": "node orchestrator/run.mjs --task-set=contention --concurrency=4",
    "run:v8:faithful": "node orchestrator/run.mjs --coordination --coord-mode=faithful --task-set=contention --concurrency=4",
    "run:contention:bare": "node orchestrator/run.mjs --task-set=contention --concurrency=4",
    "run:contention:faithful": "node orchestrator/run.mjs --coordination --coord-mode=faithful --task-set=contention --concurrency=4",
    "compare": "node orchestrator/compare-runs.mjs",
    "contention:report": "node orchestrator/contention-report.mjs",
    "salvage": "node orchestrator/salvage-progress.mjs",
    "smoke:runner": "node orchestrator/smoke-runner.mjs",
    "swarm": "node orchestrator/swarm.mjs",
    "swarm:mock": "node orchestrator/swarm.mjs --mock",
    "swarm:smoke": "node orchestrator/swarm.mjs --budget-minutes=15 --concurrency=2",
    "swarm:done": "node orchestrator/swarm.mjs --run-to-done",
    "swarm:detached": "node orchestrator/swarm.mjs --run-to-done --detach",
    "swarm:resume": "node orchestrator/swarm.mjs --resume",
    "swarm:finalize": "node orchestrator/finalize-swarm-run.mjs",
    "task:toml:import": "node tasks/toml-json/scripts/import-toml-test.mjs && node tasks/toml-json/scripts/gen-spec-txt.mjs",
    "swarm:toml:mock": "node orchestrator/swarm.mjs --mock --task=toml-json",
    "swarm:toml:smoke": "node orchestrator/swarm.mjs --task=toml-json --budget-minutes=20 --concurrency=2",
    "swarm:toml:detached": "node orchestrator/swarm.mjs --task=toml-json --run-to-done --detach",
    "task:sqlite:import": "node tasks/sqlite-micro/scripts/gen-oracle.mjs && node tasks/sqlite-micro/scripts/gen-spec-txt.mjs",
    "swarm:sqlite:mock": "node orchestrator/swarm.mjs --mock --task=sqlite-micro",
    "swarm:sqlite:smoke": "node orchestrator/swarm.mjs --task=sqlite-micro --budget-minutes=20 --concurrency=2",
    "swarm:sqlite:detached": "node orchestrator/swarm.mjs --task=sqlite-micro --run-to-done --detach",
    "report:task-run": "node orchestrator/report-task-run.mjs",
    "test:stop-policy": "node orchestrator/swarm-stop-policy.test.mjs",
    "test:eng-feedback": "node orchestrator/lib/swarm-health.test.mjs && node orchestrator/lib/spec-embedded-check.test.mjs",
    "test:token-budget": "node orchestrator/lib/token-budget.test.mjs && node orchestrator/swarm-stop-policy.test.mjs",
    "test:tree": "node orchestrator/lib/tree.test.mjs",
    "test:width": "node orchestrator/lib/width-policy.test.mjs",
    "test:ladder": "node orchestrator/lib/ladder-policy.test.mjs",
    "test:convergence": "node orchestrator/swarm-stop-policy.test.mjs && node orchestrator/lib/audit-convergence.test.mjs && node orchestrator/lib/spec-embedded-check.test.mjs && node orchestrator/lib/tree.test.mjs && node orchestrator/lib/width-policy.test.mjs && node orchestrator/lib/ladder-policy.test.mjs",
    "solo": "node orchestrator/solo.mjs",
    "solo:mock": "node orchestrator/solo.mjs --mock --run-to-done --max-turns=3",
    "solo:smoke": "node orchestrator/solo.mjs --budget-minutes=15 --max-turns=4",
    "solo:detached": "node orchestrator/solo.mjs --run-to-done --detach",
    "solo:resume": "node orchestrator/solo.mjs --resume",
    "solo:toml:detached": "node orchestrator/solo.mjs --task=toml-json --run-to-done --detach",
    "solo:sqlite:detached": "node orchestrator/solo.mjs --task=sqlite-micro --run-to-done --detach",
    "test:solo": "node orchestrator/solo-stop-policy.test.mjs",
    "ladder": "node orchestrator/ladder.mjs",
    "ladder:mock": "node orchestrator/ladder.mjs --mock",
    "ladder:toml:detached": "node orchestrator/ladder.mjs --task=toml-json --detach"
  }
}
